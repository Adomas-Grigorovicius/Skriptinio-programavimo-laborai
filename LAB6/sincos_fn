function sincos_fn
% SINCOS_FN Apskaiciuoja y = sin(x) + cos(x).
%
%   SINCOS_FN  (be argumentu)
%
%   Duomenys keiciasi tik per globalius kintamuosius:
%       x - globalus ivesties vektorius (nustatomas skripte)
%       y - globalus rezultatas, kuri funkcija sukuria ir grazina skriptui

global x y
y = sin(x) + cos(x);
end

